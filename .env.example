# App and database
APP_URL=http://localhost:5173
MONGODB_URI=mongodb+srv://<db-user>:<db-password>@<cluster-host>/wanbiz?retryWrites=true&w=majority
MONGODB_DB=wanbiz

# Authentication and initial administrator provisioning
SESSION_SECRET=replace-with-a-long-random-secret
ADMIN_EMAIL=
ADMIN_INITIAL_PASSWORD=

# Email delivery (Resend; sender domain must be verified)
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Private image and receipt storage (Cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=


# Payments (the current server client only accepts test keys)
PAYSTACK_SECRET_KEY=sk_test_replace_me